# ============================================================
# Museo Smart - Variables de entorno del frontend (Vite)
# ------------------------------------------------------------
# Copia este archivo a `.env.local` (no versionado) y ajusta los valores.
# Vite solo expone al navegador las variables con prefijo VITE_.
#   Copy-Item .env.example .env.local
# ============================================================

# ------------------------------------------------------------
# Backend
# ------------------------------------------------------------
# Base de la API. Por defecto, rutas relativas /api/v1 (proxy de Vite en
# desarrollo o mismo origen en producción).
# VITE_API_BASE_URL=/api/v1

# ------------------------------------------------------------
# Recorrido 3D
# ------------------------------------------------------------
# Ruta del modelo GLB del museo. Si se omite, se usa el modelo optimizado de
# /public (MuseoSmart2.optimizado.glb). Apunta a otra ruta para reemplazar el
# modelo sin tocar código.
# VITE_MODELO_3D_URL=/MuseoSmart2.optimizado.glb

# ------------------------------------------------------------
# Autenticación (solo desarrollo de UI)
# ------------------------------------------------------------
# false = usa el backend real. true = respuestas simuladas sin backend.
# VITE_MOCK_AUTH=false
