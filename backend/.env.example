# Copia este archivo a .env y ajusta los valores segun tu entorno local.
# NO subas el archivo .env al repositorio.

# Servidor
SERVER_PORT=8080

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/Museo_Smart
DB_USERNAME=postgres
DB_PASSWORD=postgres

# MQTT (consumidor de sensores Node-RED). El broker Docker se expone en 1884.
# Defina MQTT_USERNAME/MQTT_PASSWORD reales en su entorno o .env local (no versionar).
MQTT_BROKER_URL=tcp://localhost:1884
MQTT_CLIENT_ID=museo-smart-backend
MQTT_USERNAME=museo
MQTT_PASSWORD=

# Multimedia (imagen 5 MB / video 50 MB). Carpeta local donde se guardan los archivos.
APP_MEDIA_DIR=./media
