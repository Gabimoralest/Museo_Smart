# ============================================================
# Museo_Smart - Variables de entorno para Docker Compose
# ------------------------------------------------------------
# Copia este archivo a `.env` y ajusta los valores.
# NO subas `.env` al repositorio ni escribas secretos reales en este ejemplo.
#   Copy-Item .env.example .env
# ============================================================

# ------------------------------------------------------------
# Zona horaria
# ------------------------------------------------------------
TZ=America/Bogota

# ------------------------------------------------------------
# Puertos del HOST (izquierda de "host:contenedor").
# Se eligen altos/alternativos para evitar choques con servicios nativos
# de Windows. Cambialos si ya usas esos puertos.
# Puerto DENTRO de Docker (lado derecho) NO se cambia.
# ------------------------------------------------------------
NODERED_HOST_PORT=1881     # Node-RED UI  -> contenedor 1880
MQTT_HOST_PORT=1884        # Mosquitto     -> contenedor 1883
REDIS_HOST_PORT=6380       # Redis         -> contenedor 6379
INFLUX_HOST_PORT=8087      # InfluxDB UI   -> contenedor 8086

# ------------------------------------------------------------
# Mosquitto (autenticacion MQTT)
# ------------------------------------------------------------
MQTT_USERNAME=museo
MQTT_PASSWORD=cambia-esta-clave-mqtt

# Broker que usa el nodo MQTT del flujo Node-RED. Dentro de la red Docker es
# el servicio "mosquitto" en el puerto interno 1883. El backend (fuera de
# Docker) lo alcanza por el puerto host MQTT_HOST_PORT (1884).
MQTT_HOST=mosquitto
MQTT_PORT=1883

# ------------------------------------------------------------
# Redis (ESTADO ACTUAL de sensores y alertas; capa volatil)
# ------------------------------------------------------------
REDIS_HOST_PORT=6380       # Redis -> contenedor 6379 (el backend lo usa en 6380)
REDIS_PASSWORD=cambia-esta-clave-redis

# ------------------------------------------------------------
# InfluxDB 2.x (setup inicial + token de API)
# Org y bucket dedicados a Museo_Smart; retencion 90d configurada en compose.
# ------------------------------------------------------------
INFLUX_USERNAME=museo-admin
INFLUX_PASSWORD=cambia-esta-clave-influx
INFLUX_ORG=museo_smart
INFLUX_BUCKET=museo_smart_ambiental
INFLUX_TOKEN=cambia-este-token-influx-largo-y-aleatorio
